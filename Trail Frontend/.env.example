# Analyzer Engine Configuration
# Copy this file to .env and configure for your setup

# Mode: 'mock' (trial), 'http' (REST API), 'websocket' (real-time), 'local' (CLI via proxy)
VITE_ANALYZER_MODE=mock

# Base URL for HTTP/WebSocket engines (not needed for mock mode)
# VITE_ANALYZER_BASE_URL=http://localhost:8080

# Examples for different setups:
# --------------------------------

# For trial/testing (no engines needed):
# VITE_ANALYZER_MODE=mock

# For HTTP REST API engines:
# VITE_ANALYZER_MODE=http
# VITE_ANALYZER_BASE_URL=http://localhost:8080

# For WebSocket streaming engines:
# VITE_ANALYZER_MODE=websocket
# VITE_ANALYZER_BASE_URL=http://localhost:8080

# For local CLI engines (requires backend proxy):
# VITE_ANALYZER_MODE=local
# VITE_ANALYZER_BASE_URL=http://localhost:8080
